<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned, so a newer SDK on another machine does not add rules that fail the build. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <!-- A NuGet advisory published after hand-in must not fail the build; it stays a visible warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) is reported on build only when XML docs are generated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- No XML doc comments are required in this demo application. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
